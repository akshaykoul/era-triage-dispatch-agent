<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Looks up active ERA InsurancePolicy for a Person Account and returns policy number, name, and derived ERA tier (Total Care / Extra Care / Roadside Care).</description>
    <interviewLabel>ERA Lookup Policy {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ERA Lookup Policy</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <!-- INPUT VARIABLES -->
    <variables>
        <name>AccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <!-- OUTPUT VARIABLES -->
    <variables>
        <name>PolicyNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>PolicyName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>ProductTier</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>PolicyFound</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><booleanValue>false</booleanValue></value>
    </variables>

    <!-- RECORD LOOKUP: find active ERA policy -->
    <recordLookups>
        <name>Get_ERA_Policy</name>
        <label>Get ERA Policy</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Policy_Found</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3</filterLogic>
        <filters>
            <field>NameInsuredId</field>
            <operator>EqualTo</operator>
            <value><elementReference>AccountId</elementReference></value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value><stringValue>In Force</stringValue></value>
        </filters>
        <filters>
            <field>PolicyName</field>
            <operator>Contains</operator>
            <value><stringValue>Emergency Roadside</stringValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>InsurancePolicy</object>
        <outputAssignments>
            <assignToReference>PolicyNumber</assignToReference>
            <field>Name</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>PolicyName</assignToReference>
            <field>PolicyName</field>
        </outputAssignments>
    </recordLookups>

    <!-- DECISION: was a policy found? -->
    <decisions>
        <name>Check_Policy_Found</name>
        <label>Check Policy Found</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>No Policy Found</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Set_Not_Found</targetReference>
        </defaultConnector>
        <rules>
            <name>Policy_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PolicyNumber</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Derive_Tier</targetReference>
            </connector>
            <label>Policy Found</label>
        </rules>
    </decisions>

    <!-- DECISION: derive ERA tier from PolicyName -->
    <decisions>
        <name>Derive_Tier</name>
        <label>Derive ERA Tier</label>
        <locationX>396</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Roadside Care</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Set_Roadside_Care</targetReference>
        </defaultConnector>
        <rules>
            <name>Is_Total_Care</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PolicyName</leftValueReference>
                <operator>Contains</operator>
                <rightValue><stringValue>Total Care</stringValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Total_Care</targetReference>
            </connector>
            <label>Total Care</label>
        </rules>
        <rules>
            <name>Is_Extra_Care</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PolicyName</leftValueReference>
                <operator>Contains</operator>
                <rightValue><stringValue>Extra Care</stringValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Extra_Care</targetReference>
            </connector>
            <label>Extra Care</label>
        </rules>
    </decisions>

    <!-- ASSIGNMENTS -->
    <assignments>
        <name>Set_Total_Care</name>
        <label>Set Total Care</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <connector><targetReference>Set_Found_True</targetReference></connector>
        <assignmentItems>
            <assignToReference>ProductTier</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Total Care</stringValue></value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Extra_Care</name>
        <label>Set Extra Care</label>
        <locationX>396</locationX>
        <locationY>350</locationY>
        <connector><targetReference>Set_Found_True</targetReference></connector>
        <assignmentItems>
            <assignToReference>ProductTier</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Extra Care</stringValue></value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Roadside_Care</name>
        <label>Set Roadside Care</label>
        <locationX>616</locationX>
        <locationY>350</locationY>
        <connector><targetReference>Set_Found_True</targetReference></connector>
        <assignmentItems>
            <assignToReference>ProductTier</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Roadside Care</stringValue></value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Found_True</name>
        <label>Set Found True</label>
        <locationX>396</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>PolicyFound</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>true</booleanValue></value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Not_Found</name>
        <label>Set Not Found</label>
        <locationX>616</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>PolicyFound</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>false</booleanValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ProductTier</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Not Found</stringValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PolicyName</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>No active ERA policy found for this member.</stringValue></value>
        </assignmentItems>
    </assignments>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_ERA_Policy</targetReference>
        </connector>
    </start>
</Flow>

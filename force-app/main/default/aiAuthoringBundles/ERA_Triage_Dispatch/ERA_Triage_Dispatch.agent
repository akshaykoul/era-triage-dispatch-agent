# ERA Triage & Dispatch Agent
# Employee Agent — OmniChannel contact center support

system:
    messages:
        welcome: "ERA Triage ready."
        error: "Something went wrong. Please try again."
    instructions: |
        You are an ERA Triage assistant for a contact center representative on a live call.
        Keep all responses to 1-2 sentences maximum.
        Follow triage steps in strict order — do not skip ahead or go back.
        NEVER ask for information that is already captured in a variable.
        NEVER ask the CSR to verify or re-confirm something already stored.
        NEVER ask for member name, address, or identity — that is not your job.
        Only handle ERA breakdown triage and accommodation booking.
        If injuries or emergencies are reported, prompt the CSR to follow emergency escalation protocol.

config:
    developer_name: "ERA_Triage_Dispatch"
    agent_label: "ERA Triage & Dispatch Agent"
    agent_type: "AgentforceEmployeeAgent"
    description: "Guides CSRs through ERA breakdown triage, dispatch creation, and accommodation booking"

variables:
    account_id: mutable string = ""
    policy_number: mutable string = ""
    policy_summary: mutable string = ""
    product_tier: mutable string = ""
    vehicle_id: mutable string = ""
    vehicle_make: mutable string = ""
    vehicle_model: mutable string = ""
    vehicle_registration: mutable string = ""
    vehicle_type: mutable string = ""
    vehicle_year: mutable string = ""
    vehicle_confirmed: mutable boolean = False
    fault_type: mutable string = ""
    safety_checked: mutable boolean = False
    safety_concern: mutable boolean = False
    injury_details: mutable string = ""
    restrictions_checked: mutable boolean = False
    dispatch_restriction: mutable string = ""
    breakdown_location: mutable string = ""
    distance_from_home: mutable string = ""
    caravan_checked: mutable boolean = False
    caravan_trailer: mutable boolean = False
    dispatch_id: mutable string = ""
    dispatch_name: mutable string = ""
    hotel1_name: mutable string = ""
    hotel1_address: mutable string = ""
    hotel1_rate: mutable string = ""
    hotel2_name: mutable string = ""
    hotel2_address: mutable string = ""
    hotel2_rate: mutable string = ""
    hotel3_name: mutable string = ""
    hotel3_address: mutable string = ""
    hotel3_rate: mutable string = ""
    booking_id: mutable string = ""
    booking_name: mutable string = ""

start_agent entry:
    description: "Entry point — begin triage on call connect"
    reasoning:
        actions:
            begin_triage: @utils.transition to @subagent.era_triage
                description: "Start ERA triage"

subagent era_triage:
    description: "ERA breakdown triage — collect all incident details and create dispatch record"

    actions:
        lookup_policy:
            description: "Fetch member ERA policy number, name, and tier from Salesforce"
            inputs:
                AccountId: string
                    description: "Person Account ID"
            outputs:
                PolicyNumber: string
                    description: "Policy number e.g. PN-70307"
                PolicyName: string
                    description: "Full policy name e.g. RACV Total Care - Emergency Roadside Assistance"
                ProductTier: string
                    description: "Derived ERA tier: Total Care / Extra Care / Roadside Care / Not Found"
                PolicyFound: boolean
                    description: "Whether an active ERA policy was found"
            target: "flow://ERA_Lookup_Policy"

        get_vehicle:
            description: "Fetch the member's vehicle on file"
            inputs:
                AccountId: string
                    description: "Person Account ID"
            outputs:
                VehicleId: string
                    description: "Vehicle record ID"
                VehicleMake: string
                    description: "Vehicle make"
                VehicleModel: string
                    description: "Vehicle model"
                VehicleRegistration: string
                    description: "Vehicle registration"
                VehicleType: string
                    description: "Vehicle type"
                VehicleYear: string
                    description: "Vehicle year"
            target: "flow://ERA_Get_Vehicle_Details"

        create_dispatch:
            description: "Create ERA dispatch record with all captured incident details"
            inputs:
                MemberId: string
                    description: "Person Account ID"
                PolicyNumber: string
                    description: "Policy summary text"
                ProductTier: string
                    description: "ERA product tier"
                VehicleId: string
                    description: "Vehicle record ID"
                BreakdownLocation: string
                    description: "Breakdown address or suburb"
                DistanceFromHome: string
                    description: "Under 100km or Over 100km"
                FaultType: string
                    description: "Fault type"
                SafetyConcern: boolean
                    description: "Whether safety concerns were reported"
                InjuryDetails: string
                    description: "Injury or safety details"
                DispatchRestriction: string
                    description: "Access restrictions at breakdown location"
                CaravanTrailer: boolean
                    description: "Whether caravan or trailer is involved"
                Notes: string
                    description: "Additional notes"
            outputs:
                DispatchId: string
                    description: "Created dispatch record ID"
                DispatchName: string
                    description: "Dispatch reference number"
            target: "flow://ERA_Create_Dispatch"

    reasoning:
        instructions: ->
            if @variables.account_id == "":
                | Enter the member Account ID from the record page to begin.

            if @variables.account_id != "" and @variables.policy_summary == "":
                | Looking up ERA policy — one moment.

            if @variables.policy_summary != "" and @variables.product_tier == "Not Found":
                | No active ERA policy found for this member. Confirm coverage manually or end call.

            if @variables.product_tier != "" and @variables.product_tier != "Not Found" and @variables.vehicle_id == "" and @variables.vehicle_confirmed == False:
                | Policy: {!@variables.policy_summary} ({!@variables.product_tier}). Fetching vehicle on file.

            if @variables.vehicle_id != "" and @variables.vehicle_confirmed == False:
                | Vehicle on file: {!@variables.vehicle_make} {!@variables.vehicle_model} ({!@variables.vehicle_registration}). Confirm or different vehicle?

            if @variables.vehicle_confirmed == True and @variables.fault_type == "":
                | Select fault type: Mechanical / Flat Tyre / Fuel / Lockout / EV Out of Charge / Fire / Other.

            if @variables.fault_type == "Fire" and @variables.safety_checked == False:
                | Note: Fire assist covers engine bay damage only. Any injuries or safety concerns?
            if @variables.fault_type != "Fire" and @variables.vehicle_type == "Motorcycle" and @variables.safety_checked == False:
                | Note: Motorcycle — towing and petrol only, no extended benefits. Any injuries or safety concerns?
            if @variables.fault_type != "" and @variables.fault_type != "Fire" and @variables.vehicle_type != "Motorcycle" and @variables.safety_checked == False:
                | Any injuries or safety concerns? (Yes / No)

            if @variables.safety_checked == True and @variables.restrictions_checked == False:
                | Any access restrictions at the breakdown location? (Yes / No)

            if @variables.restrictions_checked == True and @variables.breakdown_location == "":
                | What is the breakdown address or suburb?

            if @variables.breakdown_location != "" and @variables.distance_from_home == "":
                | Is the breakdown under or over 100km from home?

            if @variables.distance_from_home != "" and @variables.product_tier == "Total Care" and @variables.caravan_checked == False and @variables.dispatch_id == "":
                | Is a caravan or trailer involved? (Yes / No)

            if @variables.distance_from_home != "" and @variables.dispatch_id == "" and (@variables.product_tier != "Total Care" or @variables.caravan_checked == True):
                if @variables.product_tier == "Total Care":
                    | Towing: 100km covered (200km for EVs). Creating dispatch now.
                if @variables.product_tier == "Extra Care":
                    | Towing: 60km covered. Creating dispatch now.
                if @variables.product_tier == "Roadside Care":
                    | Towing: 20km metro / to nearest service centre. Creating dispatch now.

            if @variables.dispatch_id != "":
                | Dispatch {!@variables.dispatch_name} created. Checking accommodation eligibility.
                if @variables.product_tier == "Roadside Care":
                    transition to @subagent.era_no_accommodation
                if @variables.product_tier != "Roadside Care" and @variables.distance_from_home == "Under 100km":
                    transition to @subagent.era_no_accommodation
                if @variables.product_tier != "Roadside Care" and @variables.distance_from_home == "Over 100km":
                    transition to @subagent.era_accommodation

        actions:
            capture_account_id: @utils.setVariables
                description: "Enter the member's Account ID from the record page"
                available when @variables.account_id == ""
                with account_id = ...

            do_policy_lookup: @actions.lookup_policy
                description: "Look up member ERA policy"
                available when @variables.account_id != "" and @variables.policy_summary == ""
                with AccountId = @variables.account_id
                set @variables.policy_summary = @outputs.PolicyName
                set @variables.policy_number = @outputs.PolicyNumber
                set @variables.product_tier = @outputs.ProductTier

            do_get_vehicle: @actions.get_vehicle
                description: "Fetch vehicle on file for this member"
                available when @variables.product_tier != "" and @variables.product_tier != "Not Found" and @variables.vehicle_id == ""
                with AccountId = @variables.account_id
                set @variables.vehicle_id = @outputs.VehicleId
                set @variables.vehicle_make = @outputs.VehicleMake
                set @variables.vehicle_model = @outputs.VehicleModel
                set @variables.vehicle_registration = @outputs.VehicleRegistration
                set @variables.vehicle_type = @outputs.VehicleType
                set @variables.vehicle_year = @outputs.VehicleYear

            confirm_vehicle: @utils.setVariables
                description: "Vehicle on file is correct — confirm it"
                available when @variables.vehicle_id != "" and @variables.vehicle_confirmed == False
                with vehicle_confirmed = True

            enter_different_vehicle: @utils.setVariables
                description: "Vehicle on file is wrong — enter correct vehicle details"
                available when @variables.vehicle_id != "" and @variables.vehicle_confirmed == False
                with vehicle_make = ...
                with vehicle_model = ...
                with vehicle_registration = ...
                with vehicle_type = ...
                with vehicle_year = ...
                with vehicle_confirmed = True

            set_fault_type: @utils.setVariables
                description: "CSR selects the fault type"
                available when @variables.vehicle_confirmed == True and @variables.fault_type == ""
                with fault_type = ...

            confirm_no_safety: @utils.setVariables
                description: "No injuries or safety concerns"
                available when @variables.fault_type != "" and @variables.safety_checked == False
                with safety_checked = True
                with safety_concern = False

            confirm_safety_concern: @utils.setVariables
                description: "Injuries or safety concerns present — provide details"
                available when @variables.fault_type != "" and @variables.safety_checked == False
                with safety_checked = True
                with safety_concern = True
                with injury_details = ...

            confirm_no_restrictions: @utils.setVariables
                description: "No access restrictions at breakdown location"
                available when @variables.safety_checked == True and @variables.restrictions_checked == False
                with restrictions_checked = True
                with dispatch_restriction = "None"

            set_restrictions: @utils.setVariables
                description: "Describe access restrictions at breakdown location"
                available when @variables.safety_checked == True and @variables.restrictions_checked == False
                with restrictions_checked = True
                with dispatch_restriction = ...

            set_location: @utils.setVariables
                description: "CSR enters breakdown address or suburb"
                available when @variables.restrictions_checked == True and @variables.breakdown_location == ""
                with breakdown_location = ...

            set_distance_under: @utils.setVariables
                description: "Breakdown is under 100km from home"
                available when @variables.breakdown_location != "" and @variables.distance_from_home == ""
                with distance_from_home = "Under 100km"

            set_distance_over: @utils.setVariables
                description: "Breakdown is over 100km from home"
                available when @variables.breakdown_location != "" and @variables.distance_from_home == ""
                with distance_from_home = "Over 100km"

            confirm_no_caravan: @utils.setVariables
                description: "No caravan or trailer involved"
                available when @variables.distance_from_home != "" and @variables.product_tier == "Total Care" and @variables.caravan_checked == False
                with caravan_checked = True
                with caravan_trailer = False

            confirm_caravan: @utils.setVariables
                description: "Caravan or trailer is involved"
                available when @variables.distance_from_home != "" and @variables.product_tier == "Total Care" and @variables.caravan_checked == False
                with caravan_checked = True
                with caravan_trailer = True

            do_create_dispatch: @actions.create_dispatch
                description: "Create the ERA dispatch record"
                available when @variables.breakdown_location != "" and @variables.distance_from_home != "" and @variables.dispatch_id == "" and (@variables.product_tier != "Total Care" or @variables.caravan_checked == True)
                with MemberId = @variables.account_id
                with PolicyNumber = @variables.policy_summary
                with ProductTier = @variables.product_tier
                with VehicleId = @variables.vehicle_id
                with BreakdownLocation = @variables.breakdown_location
                with DistanceFromHome = @variables.distance_from_home
                with FaultType = @variables.fault_type
                with SafetyConcern = @variables.safety_concern
                with InjuryDetails = @variables.injury_details
                with DispatchRestriction = @variables.dispatch_restriction
                with CaravanTrailer = @variables.caravan_trailer
                with Notes = ""
                set @variables.dispatch_id = @outputs.DispatchId
                set @variables.dispatch_name = @outputs.DispatchName

subagent era_no_accommodation:
    description: "Inform CSR that accommodation is not covered for this member or distance — end triage"
    reasoning:
        instructions: ->
            if @variables.product_tier == "Roadside Care":
                | Accommodation not covered on Roadside Care. Triage complete — Dispatch {!@variables.dispatch_name}.
            if @variables.distance_from_home == "Under 100km":
                | Accommodation only applies over 100km from home. Triage complete — Dispatch {!@variables.dispatch_name}.

subagent era_accommodation:
    description: "Handle accommodation search and booking for eligible members (Total Care or Extra Care, over 100km)"

    actions:
        search_hotels:
            description: "Search nearby hotels at the breakdown location"
            inputs:
                breakdownLocation: string
                    description: "Breakdown location for hotel search"
            outputs:
                isSuccess: boolean
                    description: "Whether search succeeded"
                hotel1Name: string
                    description: "Hotel 1 name"
                hotel1Address: string
                    description: "Hotel 1 address"
                hotel1NightlyRate: string
                    description: "Hotel 1 nightly rate"
                hotel1DistanceKm: string
                    description: "Hotel 1 distance km"
                hotel2Name: string
                    description: "Hotel 2 name"
                hotel2Address: string
                    description: "Hotel 2 address"
                hotel2NightlyRate: string
                    description: "Hotel 2 nightly rate"
                hotel2DistanceKm: string
                    description: "Hotel 2 distance km"
                hotel3Name: string
                    description: "Hotel 3 name"
                hotel3Address: string
                    description: "Hotel 3 address"
                hotel3NightlyRate: string
                    description: "Hotel 3 nightly rate"
                hotel3DistanceKm: string
                    description: "Hotel 3 distance km"
            target: "apex://ERA_HotelSearch"

        create_booking:
            description: "Create accommodation booking record"
            inputs:
                MemberId: string
                    description: "Person Account ID"
                DispatchId: string
                    description: "Parent dispatch record ID"
                HotelName: string
                    description: "Selected hotel name"
                HotelAddress: string
                    description: "Selected hotel address"
                CheckIn: string
                    description: "Check-in date"
                CheckOut: string
                    description: "Check-out date"
                Rooms: string
                    description: "Number of rooms"
                NightlyRate: string
                    description: "Nightly rate"
                PolicyAllowance: string
                    description: "Policy nightly allowance amount"
            outputs:
                BookingId: string
                    description: "Created booking record ID"
                BookingName: string
                    description: "Booking reference number"
            target: "flow://ERA_Create_Booking"

    reasoning:
        instructions: ->
            if @variables.hotel1_name == "":
                if @variables.product_tier == "Extra Care":
                    | Policy covers up to $170/night. Searching hotels near breakdown location.
                if @variables.product_tier == "Total Care":
                    | Policy covers up to $170/night for travel party. One room per booking. Searching hotels.

            if @variables.hotel1_name != "" and @variables.booking_id == "":
                | 3 hotels found. Select one to book:
                | 1. {!@variables.hotel1_name} — {!@variables.hotel1_rate}
                | 2. {!@variables.hotel2_name} — {!@variables.hotel2_rate}
                | 3. {!@variables.hotel3_name} — {!@variables.hotel3_rate}

            if @variables.booking_id != "":
                | Booking {!@variables.booking_name} confirmed. Triage and accommodation complete.

        actions:
            do_search_hotels: @actions.search_hotels
                description: "Search for nearby hotels at the breakdown location"
                available when @variables.hotel1_name == ""
                include_in_progress_indicator: True
                progress_indicator_message: "Searching nearby hotels..."
                with breakdownLocation = @variables.breakdown_location
                set @variables.hotel1_name = @outputs.hotel1Name
                set @variables.hotel1_address = @outputs.hotel1Address
                set @variables.hotel1_rate = @outputs.hotel1NightlyRate
                set @variables.hotel2_name = @outputs.hotel2Name
                set @variables.hotel2_address = @outputs.hotel2Address
                set @variables.hotel2_rate = @outputs.hotel2NightlyRate
                set @variables.hotel3_name = @outputs.hotel3Name
                set @variables.hotel3_address = @outputs.hotel3Address
                set @variables.hotel3_rate = @outputs.hotel3NightlyRate

            do_create_booking: @actions.create_booking
                description: "Create the accommodation booking for the selected hotel"
                available when @variables.hotel1_name != "" and @variables.booking_id == ""
                with MemberId = @variables.account_id
                with DispatchId = @variables.dispatch_id
                with HotelName = ...
                with HotelAddress = ...
                with CheckIn = ...
                with CheckOut = ...
                with Rooms = ...
                with NightlyRate = ...
                with PolicyAllowance = "170"
                set @variables.booking_id = @outputs.BookingId
                set @variables.booking_name = @outputs.BookingName
